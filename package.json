{
  "name": "@typed-discord/rest",
  "version": "0.0.3",
  "description": "Discord REST API client generated from the official Discord OpenAPI specification.",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./src/*.mjs",
      "types": "./src/*.d.mts"
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.mjs\"",
    "doc": "typedoc --out docs --tsconfig src/tsconfig.json",
    "build:src": "cd src && tsc",
    "build:tests": "cd tests && tsc",
    "build": "npm run build:src && npm run build:tests",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typed-discord/rest.git"
  },
  "keywords": [],
  "author": "Adrien Simonnet",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/typed-discord/rest/issues"
  },
  "homepage": "https://typed-discord.github.io/rest/",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.d.mts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
